assumption h1 : All x : All y : R(x, y)

goal : All x : (R(x, x) & (All y : R(y, x)))

proof
AllsI a (
    ConjI (
        AllsE a h1 (
            AllsE a h1 (
                Exact h1
            )
        ),
        AllsI b (
            AllsE b h1 (
                AllsE a h1 (
                    Exact h1
                )
            )
        )
    )
)
