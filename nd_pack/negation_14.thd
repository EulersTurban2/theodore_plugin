assumption h1 : P | Q
assumption h2 : P <-> Q
assumption h3 : ~(P & Q)

goal : R

proof
DisjE h1 (
    EqivE h2 (
        ImplE h21 (
            Exact h1,
            NegE h3 (
                ConjI (
                    Exact h1,
                    Exact h21
                )
            )
        )
    ),
    EqivE h2 (
        ImplE h22 (
            Exact h1,
            NegE h3 (
                ConjI (
                    Exact h22,
                    Exact h1
                )
            )
        )
    )
)
