assumption h1 : (P -> Q) | (P -> R)

goal : P -> (Q | R)

proof
ImplI hp (
    DisjE h1 (
        DisjlI (
            ImplE h1 (
                Exact hp,
                Exact h1
            )
        ),
        DisjrI (
            ImplE h1 (
                Exact hp,
                Exact h1
            )
        )
    )
)
