assumption h1 : (All x : Ex y : R(x, y)) -> ~(Ex x : R(x, x))
assumption h2 : Ex x : All y : R(y, x)

goal : All x : ~R(x, x)

proof
AllsI a (
    NegI hraa (
        ExisE b h2 (
            ImplE h1 (
                AllsI c (
                    AllsE c h2 (
                        ExisI b (
                            Exact h2
                        )
                    )
                ),
                NegE h1 (
                    ExisI a (
                        Exact hraa
                    )
                )
            )
        )
    )
)
