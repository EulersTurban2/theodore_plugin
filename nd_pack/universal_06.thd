assumption h1 : All z : (P(z) & Q(z))

goal : (All y : P(y)) & (All y : Q(y))

proof
ConjI (
    AllsI a (
        AllsE a h1 (
            ConjE h1 (
                Exact h11
            )
        )
    ),
    AllsI a (
        AllsE a h1 (
            ConjE h1 (
                Exact h12
            )
        )
    )
)
