assumption h1 : All x : All y : All z : ((R(x, y) & R(x, z)) -> R(y, z))
assumption h2 : All x : R(x, x)

goal : All x : All y : (R(x, y) -> R(y, x))

proof
AllsI a (
    AllsI b (
        ImplI h (
            AllsE a h2 (
                AllsE a h1 (
                    AllsE b h1 (
                        AllsE a h1 (
                            ImplE h1 (
                                ConjI (
                                    Exact h,
                                    Exact h2
                                ),
                                Exact h1
                            )
                        )
                    )
                )
            )
        )
    )
)
