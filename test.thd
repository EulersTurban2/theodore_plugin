macro RULE(X) = P(X) -> Q(X)

lemma InstantiateAndApply(RULE_ASSM, VAR, BASE_ASSM) = 
    AllsE VAR RULE_ASSM (
        ImplE RULE_ASSM (
            Exact BASE_ASSM ,
            Exact RULE_ASSM
        )
    )

goal : Q(a)

assumption h_rule : All x : RULE(x)
assumption h_base : P(a)

proof
InstantiateAndApply(h_rule, a, h_base)